---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const pay = `<iframe src="${SITE_URL}/embed/gs-pay-calculator/" title="2026 GS pay by grade, step and county" width="100%" height="900" style="border:0;max-width:900px" loading="lazy"></iframe>`;
const fers = `<iframe src="${SITE_URL}/embed/fers-calculator/" title="FERS annuity and supplement calculator" width="100%" height="1200" style="border:0;max-width:900px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the 2026 GS pay and FERS calculators on your site" description="Employee associations, blogs and forums can embed the 2026 GS pay calculator by county and the FERS annuity calculator with one iframe line each. Free, no cookie, no tracking." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed a calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed a calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed a calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code each. When OPM publishes new tables, the embedded calculators follow.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>GS pay by grade, step and county</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{pay}</code></pre>
    <h2>FERS annuity, supplement and survivor</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{fers}</code></pre>
    <p>The calculators run in the visitor's browser and send nothing to us or to you. Please keep the link under the calculator: it is how readers find the sources and the method.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/gs-pay-calculator/" title="2026 GS pay by grade, step and county" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
