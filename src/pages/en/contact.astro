---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { CONTACT_EMAIL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { contactPageSchema } from '../../lib/seo';
const lang = 'en';
const path = route('contact', lang);
const description = 'Write to the publisher of GS Pay and Pension about a 2026 pay cell, a FERS rule or a source. E-mail only, no advice on your own case, no product, no appointment to book.';
---
<PageLayout title="Contact GS Pay and Pension 2026: corrections and sources" description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Contact', description, path, lang })]} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none prose-headings:font-serif">
    <h1>Contact</h1>
    <p>Write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. There is no form, no phone line and no account: one e-mail address, read by the people who maintain the calculators.</p>
    <h2>Messages that help</h2>
    <ul>
      <li>A pay cell that differs from your SF-50 or from the OPM table for your area: give the grade, step, area code and the figure you see.</li>
      <li>A county that OPM's definitions place in another locality area than ours, with the link to the definition.</li>
      <li>A FERS rule that you read differently in title 5, the CFR or an OPM publication: name the section and the paragraph.</li>
      <li>A new official figure (a 2027 table, an executive order, an SSA determination) that we have not entered yet.</li>
      <li>Embedding a calculator on an employee association site, a blog or a forum: the code is on the <a href={route('widget', lang)}>embed page</a>.</li>
    </ul>
    <h2>What we cannot do</h2>
    <p>We cannot look at your personal file, confirm your service computation date, tell you which retirement date to choose or whether to elect a survivor annuity. Those questions go to your agency's human resources or benefits office, and the final computation of an annuity is made by OPM Retirement Services. We are not a government office and cannot act on a claim.</p>
    <h2>Publisher</h2>
    <LegalIdentity lang={lang} />
  </div>
</PageLayout>
